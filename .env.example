# Required for the AI chat (/chat). Server-side only.
ANTHROPIC_API_KEY=

# Required for organization-level API keys; optional for workspace-scoped keys.
# Use a workspace ID from the same organization as the API key. Server-side only.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional: override the chat model (default: claude-opus-5-5).
# CHAT_MODEL=claude-haiku-5-5

# Optional: contact form delivery (https://resend.com). Without these the
# form answers "not configured" and points visitors to LinkedIn.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL="Portfolio <hello@tanishpatel.dev>"

# Optional: Upstash Redis for view counts and shared rate limiting.
# Without these, view counts are hidden and rate limits are per-instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: raises the GitHub API limit for repo stats on project pages.
# GITHUB_TOKEN=

# Optional: used only by scripts/ingest-video.mjs to upload Brag videos.
# BLOB_READ_WRITE_TOKEN=
